{
  "name": "reset-huiliu",
  "version": "1.2.1-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "audio": "node scripts/generate-audio.mjs",
    "art:audit": "node scripts/audit-4k-art.mjs",
    "art:audit:write": "node scripts/audit-4k-art.mjs --write",
    "art:visual": "node scripts/check-art-visual-gate.mjs",
    "art:check": "node scripts/check-art-integrity.mjs && node scripts/check-4k-production.mjs && npm run art:visual",
    "art:legacy": "node scripts/check-art-integrity.mjs --legacy",
    "art:size": "node scripts/check-art-integrity.mjs --size",
    "build": "node scripts/build.mjs && npm run art:check",
    "check:release": "node scripts/check-release.mjs && node scripts/check-art-visual-gate.mjs --release",
    "test:release": "node --test tests/release.test.mjs tests/combat-input.test.mjs tests/archive.test.mjs tests/pwa.test.mjs tests/experience.test.mjs tests/art-completeness.test.mjs tests/art-visual-gate.test.mjs",
    "test:browser": "node tests/browser-release.mjs",
    "serve": "python -m http.server 8000 --directory dist"
  },
  "engines": {
    "node": ">=22"
  }
}
